{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridd1kulusc0d3r.github.io/ThePensieveProject/schemas/ai-reasoning-payload-v2.schema.json",
  "title": "Pensieve AI Reasoning Payload v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "claims",
    "uncertainties",
    "next_questions"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "claims": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "statement",
          "evidence_event_ids",
          "rationale",
          "alternatives"
        ],
        "properties": {
          "level": {
            "enum": [
              "observation",
              "inference",
              "hypothesis"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "evidence_event_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "alternatives": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "reported_confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "next_questions": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  }
}
