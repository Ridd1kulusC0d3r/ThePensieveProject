{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pensieve ForensicEvent",
  "type": "object",
  "required": [
    "timestamp",
    "event_id",
    "source",
    "artifact_type",
    "message",
    "parser",
    "parser_version"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "event_id": {
      "type": "string",
      "minLength": 8
    },
    "source": {
      "type": "string"
    },
    "artifact_type": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "host": {
      "type": [
        "string",
        "null"
      ]
    },
    "user": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "pid": {
      "type": [
        "string",
        "null"
      ]
    },
    "record_locator": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "parser": {
      "type": "string"
    },
    "parser_version": {
      "type": "string"
    },
    "time_assumption": {
      "type": "string"
    },
    "risk_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "raw": {
      "type": "object"
    }
  }
}
