{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridd1kulusc0d3r.github.io/ThePensieveProject/schemas/academy-progress.schema.json",
  "title": "Pensieve Academy Progress",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "track",
    "dataset",
    "evidence_sha256",
    "missions",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "track": {
      "enum": [
        "DFIR",
        "OSINT",
        "HYBRID"
      ]
    },
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "missions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]{1,3}$"
      },
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "optional_models": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
